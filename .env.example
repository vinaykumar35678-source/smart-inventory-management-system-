# ==============================================================================
# SmartShelf Vision AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# NEVER commit real production secrets, keys, or passwords to source control.
# ==============================================================================

# Application Information
APP_NAME="SmartShelf Vision AI"
APP_VERSION="1.0.0"
ENVIRONMENT=development

# Database Connection
DATABASE_URL="sqlite:///./inventory.db"

# Authentication & Cryptography
# Generate a strong 64-byte secret key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_64_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=14

# Rate Limiting & Brute Force Controls
AUTH_RATE_LIMIT_WINDOW=300
AUTH_MAX_ATTEMPTS=5
AUTH_COOLDOWN_ATTEMPTS=10
AUTH_COOLDOWN_SECONDS=900

# Cookie Security (Set to true in production over HTTPS)
COOKIE_SECURE=false

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# YOLO Model Configuration
YOLO_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.45

# ==============================================================================
# Gmail / SMTP Alert Notification Service
# ==============================================================================
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    - App: "Mail"
#    - Device: "SmartShelf AI"
# 3. Paste the 16-character App Password below (never use your primary Gmail password).
# ==============================================================================
GMAIL_ENABLED=false
GMAIL_USERNAME=your-store-alert@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM=your-store-alert@gmail.com
GMAIL_FROM_NAME="SmartShelf Vision AI Alerts"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
